# Where the backend (FastAPI) is reachable FROM THIS SERVER. Read on the
# server only — it is never sent to the browser, which talks to this app's
# own /api routes. Do not prefix it with NEXT_PUBLIC_.
EVERGENT_API_URL=http://localhost:8000

# Only when this app runs apart from the backend (on Vercel, say): the same
# value as the backend's FRONTEND_PROXY_SECRET, so the backend can tell each
# browser apart for rate limits. Leave it unset when both share a network.
FRONTEND_PROXY_SECRET=
