# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | test | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated. The browser-facing origin(s) of the frontend.
CORS_ORIGINS=http://localhost:3000
# Where emailed links point (password reset, email verification).
FRONTEND_URL=http://localhost:3000
# "Continue with Google" (optional). Create an OAuth client of type "Web
# application" in Google Cloud and add this authorized redirect URI:
#   <frontend URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Peers whose X-Forwarded-For is believed (the frontend server, a reverse
# proxy). Comma-separated IPs/CIDRs.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# A frontend hosted apart from the API (on Vercel, say) proves itself with
# this shared secret instead, since its address changes. At least 32
# random characters; set the same value in the frontend's environment.
FRONTEND_PROXY_SECRET=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://evergent:evergent@localhost:5432/evergent
DB_ECHO=false

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Security --------------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Per client per minute, shared across API processes through Redis.
RATE_LIMIT_PER_MINUTE=600
# Sign-in, sign-up, password reset, verification.
AUTH_RATE_LIMIT_PER_MINUTE=20
# REQUIRED IN PRODUCTION — encrypts provider API keys at rest.
# Generate with: python -c "from app.core.security import generate_encryption_key as g; print(g())"
ENCRYPTION_KEY=

# --- Execution limits ------------------------------------------------------
# Safety rails. A workflow that breaches one is stopped, not billed further.
MAX_WORKFLOW_COST_USD=5.0
# Across all of one user's workflows, per UTC day.
MAX_DAILY_COST_USD=20.0
MAX_WORKFLOW_TOKENS=2000000
MAX_WORKFLOW_SECONDS=1800
MAX_TASKS_PER_WORKFLOW=40
MAX_TASK_RETRIES=3
MAX_PARALLEL_TASKS=4
TASK_TIMEOUT_SECONDS=300

# --- AI providers ----------------------------------------------------------
# At least one is required for a workflow to run. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Any OpenAI-compatible gateway (OmniRoute, vLLM, LiteLLM, ...).
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=

# --- Optional integrations ---------------------------------------------------
# Web search for agents. Without either key the tool is reported unavailable.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Email. Without SMTP_HOST nothing is sent (in development the link is logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Evergent <no-reply@example.com>
SMTP_STARTTLS=true
REQUIRE_EMAIL_VERIFICATION=false

# --- Execution and storage ------------------------------------------------------
# "inline" runs workflows in the API process; "celery" hands them to a worker.
EXECUTION_BACKEND=inline
# Generated tests run in throwaway Docker containers (needs a local Docker).
SANDBOX_ENABLED=true
# "local", "s3" (any S3-compatible store) or "database" (in Postgres, for
# hosts with no persistent disk).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=~/.evergent/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 asks the store to encrypt objects; leave empty for stores that reject it.
S3_SERVER_SIDE_ENCRYPTION=AES256
