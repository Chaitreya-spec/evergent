# Configuration for `docker compose up` (docker-compose.yml). Copy to .env and
# fill in the REQUIRED values. Placeholders only — never commit a real .env.

# --- REQUIRED ---------------------------------------------------------------
# Database password (any long random string).
#   openssl rand -base64 32
POSTGRES_PASSWORD=
# Signs session tokens. At least 32 random characters.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts provider API keys stored through the UI (a Fernet key).
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# --- Where people reach it ---------------------------------------------------
# The public address, used in emailed links and as the allowed browser origin.
PUBLIC_URL=http://localhost:3000
# With `docker compose --profile tls up`, the domain Caddy gets a certificate for.
DOMAIN=
# Host port for the frontend (bound to 127.0.0.1).
FRONTEND_PORT=3000

# --- Model providers (at least one, here or later in the UI) ------------------
# Keys can instead be entered by an administrator under Models & providers,
# where they are stored encrypted.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible gateway (OmniRoute, LiteLLM, vLLM, ...).
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=

# --- Optional integrations ----------------------------------------------------
# Web search for agents (one of them). Without either, the tool is unavailable.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Email (password reset, address verification). Without SMTP_HOST no email is
# sent and those flows say so.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Evergent <no-reply@example.com>

# File storage: "local" (a Docker volume) or "s3" (any S3-compatible store).
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 asks the store to encrypt objects; leave empty for stores that reject it.
S3_SERVER_SIDE_ENCRYPTION=AES256

# --- Limits -------------------------------------------------------------------
# Per workflow, and per user per UTC day, in estimated USD.
MAX_WORKFLOW_COST_USD=5.0
MAX_DAILY_COST_USD=20.0
# Requests per minute per client: general, and for sign-in/password reset.
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
WORKER_CONCURRENCY=2

# Tag for the built images (e.g. a git SHA), used for rollbacks.
IMAGE_TAG=latest
